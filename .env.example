# Copy to .env (ignored). Generate fresh secrets; never use test credentials.
# Hex avoids URL and Compose interpolation issues in the database password.
POSTGRES_PASSWORD=replace_with_random_hex
API_SERVICE_SECRET=replace_with_random_64_character_hex
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000

# Keep local-only by default; set the company LAN IP for intranet deployment.
WEB_BIND_ADDRESS=127.0.0.1
